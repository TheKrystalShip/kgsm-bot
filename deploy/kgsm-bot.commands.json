        "mutates": false,
        "options": [
          {
            "name": "channel",
            "description": "Channel announcements are posted in",
            "type": "channel",
            "required": true,
            "autocomplete": false
          }
        ]
      },
      {
        "name": "setup board",
        "description": "Give each game server its own channel, under a category",
        "mutates": false,
        "options": [
          {
            "name": "category",
