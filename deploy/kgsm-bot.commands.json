            "type": "channel",
            "required": true,
            "autocomplete": false
          }
        ]
      },
      {
        "name": "setup board-off",
        "description": "Stop making a channel per game server here",
        "mutates": false,
        "options": []
      },
      {
        "name": "setup forget",
        "description": "Stop announcing in this Discord server entirely",
        "mutates": false,
        "options": []
      },
      {
