# kgsm-bot.env — this host's own configuration + secrets for the kgsm-bot systemd unit.
#
# Copy to /etc/kgsm-bot/kgsm-bot.env (chmod 600) and fill in. setup.sh copies this template on
# first run and NEVER overwrites it afterwards, so the token and the channel map survive a redeploy.
#
# kgsm-bot.settings.json, installed beside the binary, declares the bot's whole configurable surface
# with its defaults. A variable here overrides ONE key of that file, spelling the key's path with
# "__". A variable naming a key the file does not declare binds to nothing, so check the spelling
# against that file — a test fails the build if this template ever names one that is not declared.

# ── REQUIRED — the Discord bot token ──────────────────────────────────────────
# Get or rotate it in the Discord developer portal (Bot -> Reset Token). Treat it like a password;
# it is deliberately not in the committed settings file, which ships in the /opt deploy artifact.
Discord__Token=YOUR_DISCORD_BOT_TOKEN_HERE

# ── REQUIRED — which Discord server this bot serves ───────────────────────────
# The guild. Left at 0 the bot still signs in, but it cannot resolve the server it belongs to:
# creating a channel for a newly installed game server fails with "could not find guild".
Discord__GuildId=0
# Category new server channels are created under. 0 leaves them uncategorised.
Discord__InstancesCategoryId=0
# Role whose holders may start, stop and otherwise act on servers from Discord — the same role the
# assistant checks. 0 means no one is authorized to act.
Discord__ActionRoleId=0

# Channel for announcements about servers with no channel of their own — a server the bot never saw
# installed and that is missing from the map below. 0 drops those announcements and logs why.
# Discord__AnnouncementChannelId=0

# The per-server channel map is NOT here, and cannot be: systemd refuses an environment variable
# whose name contains a hyphen, so a server called "minecraft-homestead" would be dropped with an
# "Ignoring invalid environment assignment" in the journal and given a new channel on its next
# event. That map lives in kgsm-bot.settings.json, which can express every name.

# ── What the bot announces ───────────────────────────────────────────────────
# One switch per engine event, all declared in kgsm-bot.settings.json with the defaults shown here.
# The Control Panel writes these; set one below to pin it on this host regardless of what the panel
# does. There is no switch for "an update is available" — the engine emits no such event, and the
# bot has no second source it could honestly answer from.
# Discord__Announce__Started=true
# Discord__Announce__Ready=false          # follows every start, including the supervisor's own
# Discord__Announce__Stopped=true
# Discord__Announce__Restarted=true
# Discord__Announce__Crashed=true         # once per crash, not once per restart attempt
# Discord__Announce__Failed=true
# Discord__Announce__Updated=true
# Discord__Announce__Installed=true
# Discord__Announce__Uninstalled=true
# Discord__Announce__BackupCreated=false
# Discord__Announce__BackupRestored=true
# Discord__Announce__PlayerJoined=false   # one message per join
# Discord__Announce__PlayerLeft=false
# Discord__Announce__Moderation=true      # kicks, bans, and lifted bans

# ── Optional overrides (the unit already sets the first two) ──────────────────
# KGSM__Path=/usr/local/bin/kgsm
# KGSM__JournalDir=/var/lib/kgsm/events
# KGSM__WatchdogSocketPath=/run/kgsm-watchdog/control.sock
# Ollama__Endpoint=http://localhost:11434
# Logging__LogLevel__Default=Information
