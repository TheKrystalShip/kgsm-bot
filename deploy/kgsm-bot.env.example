# kgsm-bot environment file — deployed to /etc/kgsm-bot/kgsm-bot.env (chmod 600).
# Override any appsettings.json key here via Section__Key (DOUBLE underscore = ':' nesting).
# The deploy script copies this template to /etc/kgsm-bot/kgsm-bot.env on first run and NEVER
# overwrites it afterwards, so your secret survives a redeploy.

# REQUIRED — the Discord bot token. It is kept OUT of the committed appsettings.json (which ships
# in the /opt deploy artifact). Get/rotate it in the Discord developer portal (Bot -> Reset Token).
# Treat it like a password; never commit it.
Discord__Token=YOUR_DISCORD_BOT_TOKEN_HERE

# --- Optional overrides (the systemd unit already sets sane defaults for these) ---
# Path to the host's kgsm.sh:
# KGSM__Path=/home/heisen/tks/kgsm/kgsm.sh
# The bot's dedicated kgsm event-listen socket (must be in kgsm's event_socket_filenames):
# KGSM__SocketPath=/run/kgsm-bot/kgsm-events.sock
# Local Ollama endpoint for the assistant integration:
# Ollama__Endpoint=http://localhost:11434
