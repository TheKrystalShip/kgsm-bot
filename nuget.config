<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Adds a local folder feed for TheKrystalShip.Llm (packed from the sibling
    repo at /home/heisen/TheKrystalShip.Llm). This is merged with the global
    sources (nuget.org, github), so their credentials are preserved.
    Once TheKrystalShip.Llm is published to the github/nuget.org feed, this
    local source can be removed.
  -->
  <packageSources>
    <add key="local-thekrystalship-llm" value="/home/heisen/local-nuget" />
  </packageSources>
</configuration>
