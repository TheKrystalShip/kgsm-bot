<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>KGSM.Bot.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KGSM.Bot.Core\KGSM.Bot.Core.csproj" />
    <!-- kgsm-lib consumed as the packed NuGet from the local feed (nuget.config →
         /home/heisen/local-nuget), same pattern as every other .NET consumer. -->
    <PackageReference Include="TheKrystalShip.KGSM.Lib" Version="3.1.0" />
  </ItemGroup>
</Project>
