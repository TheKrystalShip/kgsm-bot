<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>KGSM.Bot.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
    <!-- Listening and speaking in a Discord voice channel, which is about Discord and speech and
         not about game servers. The interfaces the bot implements to plug KGSM into it — recognition,
         the speech engine, what a spoken command means — are declared there. -->
    <PackageReference Include="TheKrystalShip.Discord.Voice" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TheKrystalShip.KGSM.Lib" Version="9.0.0-dev.1" />
  </ItemGroup>
</Project>
