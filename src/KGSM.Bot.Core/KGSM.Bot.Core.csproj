<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>KGSM.Bot.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- kgsm-lib consumed as the packed NuGet from the local feed (nuget.config →
         /home/heisen/local-nuget), same pattern as every other .NET consumer. -->
    <PackageReference Include="TheKrystalShip.KGSM.Lib" Version="4.23.1" />
    <!-- The ecosystem's shared authority ladder. A question put to the assistant carries the asker's
         tier, so the type that spells it belongs with the interfaces rather than being re-stated. -->
    <PackageReference Include="TheKrystalShip.KGSM.Auth" Version="3.0.0" />
  </ItemGroup>
</Project>
