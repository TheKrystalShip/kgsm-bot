<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Discord.Net builds a CultureInfo from each guild's preferred_locale while handling
         GUILD_AVAILABLE. Under invariant globalization alone, `new CultureInfo("en-US")` throws
         CultureNotFoundException, that dispatch fails, and the SocketGuild is never populated —
         so GetChannel() returns null for every channel and the bot cannot post at all, while the
         gateway still reports Connected and the unit still reports active. This lets a culture be
         constructed by any name and behave as the invariant one, which is all this bot needs: it
         formats nothing per-locale, and the guild's locale is only ever stored. Keeping invariant
         globalization keeps the ICU dependency off the deploy. -->
    <PredefinedCulturesOnly>false</PredefinedCulturesOnly>
    <RootNamespace>KGSM.Bot.Discord</RootNamespace>
    <AssemblyName>kgsm-bot</AssemblyName>
    <Version>3.13.0</Version>

    <!-- Framework-dependent single-file deploy: the host has the .NET 10 runtime installed,
         so we don't bundle it (smaller artifact). Publish-only props (build/test ignore them);
         the RID is supplied at publish time (deploy/deploy.sh passes -r linux-x64). -->
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <SelfContained>false</SelfContained>

    <!-- Memory footprint: Workstation GC, NOT the default Server GC. On a many-core host
         Server GC allocates one heap + one GC thread PER CORE, sizes those heaps generously,
         and retains freed segments as a standby cache — this idle Discord bot crept to ~110 MB
         and never gave it back. Workstation GC = one heap that releases at idle. The two GC knobs
         with no MSBuild property — System.GC.ConserveMemory (aggressive decommit/compaction) and
         System.GC.RetainVM=false (hand freed pages back) — live in runtimeconfig.template.json
         next to this file; the SDK auto-merges it into the generated runtimeconfig.json at
         build/publish (and PublishSingleFile embeds that in the binary, so it survives a deploy).
         Expected result: ~110 MB → ~40-50 MB (matching the kgsm-api experience). -->
    <ServerGarbageCollection>false</ServerGarbageCollection>

    <!-- The leaf config descriptor is generated from the settings types in this project and in
         KGSM.Bot.Infrastructure. These name the two files the generator works between. -->
    <LeafSettingsFile>kgsm-bot.settings.json</LeafSettingsFile>
    <LeafDescriptorFile>$(MSBuildProjectDirectory)/../../deploy/kgsm-bot.leaf.json</LeafDescriptorFile>

    <!-- The command catalog the Control Panel lists. Generated beside the descriptor, from the
         binary rather than from source, by the target at the bottom of this file. -->
    <BotCommandManifestFile>$(MSBuildProjectDirectory)/../../deploy/kgsm-bot.commands.json</BotCommandManifestFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Build-only: the attributes arrive as source and the generator as a tool, and the package
         declares no dependencies, so nothing here reaches the published output. -->
    <PackageReference Include="TheKrystalShip.KGSM.LeafConfig" Version="2.2.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.5" />
    <!-- Individual Discord.Net sub-packages (not the meta-package) to avoid bundling
         Discord.Net.Commands and Discord.Net.Webhook which this bot never uses. -->
    <PackageReference Include="Discord.Net.Core" Version="3.13.0" />
    <PackageReference Include="Discord.Net.Interactions" Version="3.13.0" />
    <PackageReference Include="Discord.Net.WebSocket" Version="3.13.0" />
    <PackageReference Include="TheKrystalShip.KGSM.Auth" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KGSM.Bot.Infrastructure\KGSM.Bot.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The kgsm port adapters are internal glue; let the test project wire them. -->
    <InternalsVisibleTo Include="KGSM.Bot.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="kgsm-bot.settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="kgsm-bot.settings.*.json">
      <DependentUpon>kgsm-bot.settings.json</DependentUpon>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- runtimeconfig.template.json is a BUILD INPUT (the SDK merges it into the generated
       kgsm-bot.runtimeconfig.json by filename convention, independent of any Content item), so
       it must NOT ship in the publish tree. The SDK globs **/*.json into Content by default,
       which would otherwise copy it to /opt/kgsm-bot on deploy — drop it so the artifact stays
       exactly the binary + kgsm-bot.settings.json. Removing it from Content does not affect the merge. -->
  <ItemGroup>
    <Content Remove="runtimeconfig.template.json" />
    <None Include="runtimeconfig.template.json" />
  </ItemGroup>

  <Target Name="SetSourceRevisionId" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo;CoreCompile"
          Condition="'$(SourceRevisionId)' == ''">
    <Exec Command="git -C &quot;$(MSBuildProjectDirectory)&quot; rev-parse --short=12 HEAD"
          ConsoleToMSBuild="true" ContinueOnError="true" StandardErrorImportance="low" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitShortSha" />
      <Output TaskParameter="ExitCode" PropertyName="_GitExitCode" />
    </Exec>
    <PropertyGroup Condition="'$(_GitExitCode)' == '0' and '$(_GitShortSha)' != ''">
      <SourceRevisionId>$(_GitShortSha)</SourceRevisionId>
    </PropertyGroup>
  </Target>

  <!-- Write the command manifest by running the binary that was just built. The catalog is read out
       of the assembly's own modules, so the file cannot name a command this build does not register,
       and a rename or a new command reaches the Control Panel with no second edit. Same reason the
       leaf descriptor is generated rather than written — and, like it, the result is committed.
       Inputs/Outputs keep it off no-op builds; a design-time build never runs it. -->
  <Target Name="EmitBotCommandManifest" AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="$(TargetPath)" Outputs="$(BotCommandManifestFile)">
    <Exec Command="dotnet exec &quot;$(TargetPath)&quot; --emit-commands &quot;$(BotCommandManifestFile)&quot;"
          StandardOutputImportance="low" />
    <Message Importance="normal" Text="kgsm-bot command manifest → $(BotCommandManifestFile)" />
  </Target>
</Project>
