{
  // === KGSM Discord bot — configuration ===
  //
  // This file declares the bot's WHOLE configurable surface, each key with its default. It is the
  // floor; an environment variable overrides one key of it by spelling that key's path with "__" —
  // Discord__Token, KGSM__Path, Logging__LogLevel__Default. A variable naming a key that is not
  // declared here binds to nothing.
  //
  // Every key here maps onto a property of the options class the bot binds that section into, and a
  // test fails the build if the two ever disagree, in either direction, or if the leaf descriptor
  // (deploy/kgsm-bot.leaf.json — what the Control Panel renders) drifts from either.
  //
  // SECRETS ARE DECLARED HERE, NEVER SET HERE. The Discord token is this host's own — it is declared
  // blank so the Control Panel can see it exists, and its real value belongs in the root-owned
  // /etc/kgsm-bot/kgsm-bot.env, which is not in version control.
  //
  // NO DISCORD SERVER IS NAMED IN THIS FILE. Which Discord servers hear about this host, the channel
  // each takes announcements in, and whether it keeps a channel per server are set with /setup from
  // inside Discord and recorded in the guild store (Guilds:DbPath) — one admin, no file to edit, no
  // restart. What this host announces at all is host policy and is below.
  // The Discord application the host signs people in through, shared with the Control Panel API and
  // the assistant. The bot signs nobody in and needs neither key; it declares them so the Control
  // Panel can show the host's whole sign-in block in one place. The secret is delivered by the
  // environment. Owned by TheKrystalShip.KGSM.Auth.
  "KgsmAuth": {
    "Providers": {
      "discord": {
        "ClientId": "",
        "ClientSecret": ""
      }
    }
  },

  // Who may do what here. A Discord account says who somebody is; the KGSM account it is connected to
  // says what they may do, and that account is the only thing consulted — a guild role is a fact
  // about a chat server and grants nothing. One file per host, shared with the Control Panel API and
  // the assistant, so the same person holds the same tier on all three. Read straight off disk: a
  // file cannot be down, so the bot keeps authorizing people with every other leaf stopped.
  "Auth": {
    "UsersDbPath": "/var/lib/kgsm/auth/users.db"
  },

  // Which Discord servers the bot announces into, and the channel each server reports in. Written by
  // /setup, never by hand: it is the bot's own file, it holds the binding that ties a server to the
  // channel carrying its history, and it deliberately sits OUTSIDE /opt/kgsm-bot, which the deploy
  // syncs with rsync --delete.
  "Guilds": {
    "DbPath": "/var/lib/kgsm-bot/bot.db"
  },

  "Discord": {
    "Token": "",
    "RemoveChannelOnInstanceDeletion": false,

    // The address /connect hands out. A host cannot discover the name people actually type, so set it
    // when this one is reached by a domain name; left blank, the bot uses the external IP the host
    // measures for itself.
    "PublicAddress": "",

    // What an announcement about a server that is down carries with it. A button is a shortcut to the
    // slash command — authorized at the click, against the same account store — so turning it off
    // costs the shortcut and never the safety. A thread needs "Create Public Threads"; without the
    // permission the announcement posts plainly and nothing else changes.
    "ActionButtons": true,
    "IncidentThreads": true,

    // Whether the assistant investigates a server the supervisor has given up on and posts what it
    // found in that server's thread, before anybody asks. It reads only: the turn is asked with
    // auto-run off, and anything it proposes is dropped rather than offered to a thread that asked
    // for nothing. Needs an assistant configured and a thread to post in; without either, a give-up
    // is announced exactly as it is with this off.
    "IncidentTriage": true,

    // The live status message, kept current by EDITING one message — the channel-edit rate limit is
    // what makes a name-based status board unbuildable, and a message edit is a different bucket
    // entirely. The floor turns a burst (a host reboot is one event per server) into a single edit;
    // the refresh is only a backstop for what no event describes.
    "StatusMessageMinIntervalSeconds": 15,
    "StatusMessageRefreshSeconds": 900,

    // The line beside the bot's own name — "Watching 6 servers · 3 online". The only thing this bot
    // says with no channel to say it in: it reaches a Discord server that has never run /setup, and one
    // update covers every one of them at once. A gateway presence update is limited to a handful per
    // twenty seconds for the WHOLE session, and that budget is not the one the send queue paces below,
    // so the cadence here is the only thing protecting it — which is why the line is recomposed on a
    // fixed tick, never in response to an event, and sent only when it actually changed.
    "Presence": true,
    "PresenceRefreshSeconds": 60,

    // How old a server's newest backup has to be before the live status message flags it. The board
    // stays QUIET while backups are current and speaks when they are not — an age printed beside all
    // sixteen servers buries the one that matters among fifteen that do not. A server that has never
    // been backed up is always flagged; 0 shows the age for every server.
    "BackupStaleAfterHours": 48,

    // Everything the bot says on its own initiative goes out through one paced queue: announcements
    // across guilds, the board's per-guild edits, channels created with an install, expiring messages
    // cleaned up. Four producers that know nothing of each other are one stream by the time they
    // reach Discord. Rate-limit headroom is a host-wide resource, and being throttled off the API
    // loses everything else with the call that did it.
    //
    // The FLOOR is the part that matters — it keeps a limit from being reached at all, where a
    // backoff only reacts to one already spent. The backoff pauses the WHOLE queue rather than
    // spinning one call against a limit while the rest starve behind it, and it doubles to the
    // ceiling. Only a rate limit, a server error or a dropped connection is re-tried; a refusal or a
    // missing channel is the answer and is failed at once. A full queue REFUSES and says so — the
    // caller reports the guild it did not reach, because a silent drop makes a bot that announces
    // nothing look like a host where nothing happened.
    //
    // Slash-command replies deliberately do NOT come through here: Discord gives three seconds to
    // acknowledge an interaction, and a reply queued behind a backlog arrives after the token is dead.
    "SendQueueMinIntervalMs": 200,
    "SendQueueCapacity": 500,
    "SendQueueMaxAttempts": 4,
    "SendQueueBackoffMs": 1000,
    "SendQueueMaxBackoffMs": 60000,

    "Status": {
      "Online": "🟢",
      "Offline": "🔴",
      "Uninstalled": "⚫"
    },

    // What the bot announces. Each key is one engine event the bot reads off the journal; there is
    // no key here the engine does not emit, so nothing in this list is polled, derived or guessed.
    // The ones that start off fire on their own cadence rather than on an operator's action —
    // "Ready" follows every start including the supervisor's own restarts, and a busy server
    // produces a join and a leave per player per session.
    "Announce": {
      "Started": true,
      "Ready": false,
      "Stopped": true,
      "Restarted": true,
      "Crashed": true,
      "Failed": true,
      "UpdateAvailable": true,
      "Updated": true,
      "Installed": true,
      "Uninstalled": true,
      "BackupCreated": false,
      "BackupRestored": true,
      "PlayerJoined": false,
      "PlayerLeft": false,
      "Moderation": true
    },

    // Whether the bot may sit in a voice channel and listen. OFF by default and deliberately so:
    // every other surface acts on what somebody typed at it, while this one takes in everybody in the
    // room — including people who never addressed the bot and cannot see that it is listening.
    // Nothing is written to disk either way; an utterance lives in memory only as long as it takes to
    // hand it on.
    //
    // The three durations decide where one person's sentence ends. The silence gap is the one worth
    // tuning: too short cuts people off mid-thought, too long makes every answer wait for it. The
    // ceiling is not a limit on how long somebody may talk, it is a limit on how much audio is held
    // for one of them at a time.
    // The trigger is matched against the TRANSCRIPT, not against a sound — there is no wake-word
    // model, everything said is recognised anyway and the phrase is found in the text. So the
    // property a good trigger needs is that the recogniser renders it the same way every time,
    // which is why it is a list: an operator who sees a variant in the log adds it here, with
    // nothing to retrain. It has to open the sentence, which is what stops the bot answering a
    // conversation that merely mentions it.
    //
    // The model file lives under the state directory and not the install prefix, because deploy.sh
    // syncs the prefix with rsync --delete and would take it on every deploy.
    "Voice": {
      "Enabled": false,
      "SilenceGapMs": 800,
      "MinUtteranceMs": 400,
      "MaxUtteranceSeconds": 20,
      "LeaveWhenAlone": true,
      "ModelPath": "/var/lib/kgsm-bot/models/ggml-small.en.bin",
      "UseGpu": true,
      "Triggers": "hey assistant",
      "FollowUpSeconds": 10,
      "LogTranscripts": false,

      // The recogniser knows English, not this host: a server called "Ketchup" comes back as
      // "catch-up" until something tells whisper the name exists. Naming the servers as prior context
      // shifts it toward this host's spellings, refreshed as they are installed and removed. Nothing
      // downstream rewrites what anybody said — correcting a misheard name after the fact means
      // guessing which server was meant and then acting on the guess.
      "PrimeWithServerNames": true,

      // Answering a question the bot just asked you should not require re-addressing it. The window
      // belongs to the one speaker who was asked, is spent by a single utterance, and never opens
      // while an action is staged — approving is the buttons' job and stays there. 0 disables.
      "ReplyWindowSeconds": 20,

      // Approving a staged action out loud, for hands that are in a game. Everything waiting is named
      // before the question is asked, so one yes covers all of it — and only an unmistakable yes
      // counts. Anything else is asked again in as many words; nothing is ever resolved toward
      // approval because it was closer to yes than to no. The buttons are posted either way.
      "ConfirmByVoice": true,

      // Silence reads as broken. A turn takes seconds and a confirmed install was measured at 32 of
      // them, all silent — indistinguishable from a bot that never heard you. The phrase is spoken
      // ALONGSIDE the work, never before it, so the first sound arrives sooner and the answer does
      // not arrive later.
      "Acknowledge": true,

      // The two listening states, as tones rather than as sentences. Rising means the floor is yours
      // and a window is counting down; falling means the request has been taken. The same pair of
      // notes in opposite order, which is what makes them learnable without being explained.
      //
      // A tone does not wear out the way a fixed phrase does, and costs no synthesis — so it arrives
      // immediately instead of after a model has produced a waveform. Off, those moments are spoken
      // instead. Anything with something to TELL you — a long job, a yes it could not make out — is
      // always spoken, because a tone cannot say why.
      "Chimes": true,

      // Recognition normally runs on a FINISHED sentence, which puts the "go ahead" tone after the
      // words it was meant to encourage. This reads the opening of a sentence while the rest is still
      // being spoken, purely to find out early that the bot is being addressed.
      //
      // A partial reading may only make a SOUND — never a decision. It is the first second and a half
      // of a sentence nobody has finished, and the same audio arrives again complete a moment later;
      // that copy is the one that is read and acted on.
      //
      // It costs a whole recognition pass (whisper pads to a fixed window, so 1.5s costs about what
      // the sentence costs) on most of what is said in the channel, addressed to the bot or not. It is
      // skipped outright whenever the recogniser is busy, so it can never delay a real answer. 0 off.
      "EarlyTriggerMs": 1500,

      // Answering out loud. Synthesis on the card is around eight times faster than on the processor
      // and costs roughly 700MB of video memory; a host without a usable card (the CUDA path needs
      // cuDNN, which recognition does not) falls back on its own and says so in the log.
      //
      // The WHOLE reply is spoken, with only the markup stripped — never a summary and never cut
      // short. A surface that rewords a reply on its way to being read out says things the assistant
      // did not, and one that stops part-way has decided somebody heard enough, which is not its
      // call. How long an answer runs is the assistant's to control: a spoken turn already asks for
      // a reply written to be heard.
      "Speak": true,
      "SpeechModelPath": "/var/lib/kgsm-bot/models/kokoro.onnx",
      "SpeechVoice": "af_heart",
      "SpeakUseGpu": true
    },

    // Whether "what's the status" answers go only to the person who asked. /status, /list, /is-active
    // and /supervision are one person's question, and a busy channel does not need everyone else's in
    // its scrollback. The commands whose point is to be SHARED — /connect above all — are deliberately
    // not covered by this, and /logs is always private whatever this says, because a game log carries
    // the network address of every player who connected.
    "EphemeralReads": true,

    "DeleteStatusMessageAfterDelay": false,
    "DeleteStatusMessageDelaySeconds": 300
  },

  // Where the engine is and where its event journal lives. "Blueprints" gives the per-game log line
  // that means "the server finished starting" — a map keyed by name, so an entry binds from its own
  // key (KGSM__Blueprints__factorio__OnlineTrigger), a single variable cannot express one, and the
  // Control Panel does not render it.
  "KGSM": {
    "Path": "/usr/local/bin/kgsm",
    "JournalDir": "/var/lib/kgsm/events",
    "WatchdogSocketPath": "/run/kgsm-watchdog/control.sock",
    "StatusSocketPath": "/run/kgsm-bot/status.sock",
    "FirewallSocketPath": "/run/kgsm-firewall/firewall.sock",
    "Blueprints": {
      "7dtd": {
        "OnlineTrigger": "INF StartGame done"
      },
      "barotrauma": {
        "OnlineTrigger": "Server started"
      },
      "corekeeper": {
        "OnlineTrigger": "Game ID"
      },
      "dontstarvetogether": {
        "OnlineTrigger": "Server registered via geo DNS in"
      },
      "empyrion": {
        "OnlineTrigger": "Server started listening on port"
      },
      "factorio": {
        "OnlineTrigger": "Hosting game at IP ADDR"
      },
      "minecraft": {
        "OnlineTrigger": "For help, type \"help\""
      },
      "necesse": {
        "OnlineTrigger": "Started server using port"
      },
      "projectzomboid": {
        "OnlineTrigger": "SERVER STARTED"
      },
      "starbound": {
        "OnlineTrigger": "UniverseServer: listening for incoming TCP connections"
      },
      "starmade": {
        "OnlineTrigger": "SERVER INIT FINISHED"
      },
      "terraria": {
        "OnlineTrigger": "Server started"
      },
      "valheim": {
        "OnlineTrigger": "Opened Steam server"
      },
      "veloren": {
        "OnlineTrigger": "Server is ready to accept connections"
      },
      "vrising": {
        "OnlineTrigger": "Startup Completed - Disabling Scene Loading Systems"
      }
    }
  },

  // How long the server and blueprint lists are reused before being re-read, so the bot does not
  // spawn a kgsm subprocess per message. Backstops only: install and uninstall drop the list at once.
  "KgsmCache": {
    "InstancesTtlSeconds": 300,
    "BlueprintsTtlSeconds": 600
  },

  // The kgsm-assistant leaf, which answers when the bot is @-mentioned. It is one service behind every
  // surface, so a conversation held in Discord is the same conversation the Control Panel and the
  // assistant's own site show that person. The secret is the host's shared relay secret — it
  // authenticates the bot as a trusted relay, while the identity and authority it forwards are always
  // the asking person's. No address configured leaves the conversational surface off; slash commands,
  // announcements and channel status are unaffected.
  "Assistant": {
    "BaseUrl": "",
    "RelaySecret": "",
    "TimeoutSeconds": 300
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "KGSM.Bot": "Debug"
    }
  }
}
