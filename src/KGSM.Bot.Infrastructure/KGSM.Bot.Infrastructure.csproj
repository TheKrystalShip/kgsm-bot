<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>KGSM.Bot.Infrastructure</RootNamespace>

    <!-- This library declares bound settings sections, so it compiles the descriptor attributes and
         emits the documentation file their <panel> tags travel in. It generates nothing itself — the
         Discord host owns that step. -->
    <GenerateLeafDescriptor>false</GenerateLeafDescriptor>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TheKrystalShip.KGSM.LeafConfig" Version="2.2.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The assistant client's transport seam is internal; let the tests supply one. -->
    <InternalsVisibleTo Include="KGSM.Bot.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.5" />
    <!-- BackgroundService, for the worker that drains the voice queue. Abstractions only: this
         project hosts nothing, it just needs the base class the entry point will host. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.5" />
    <PackageReference Include="Discord.Net" Version="3.20.1" />
    <!-- Hearing and speaking. The models are NOT here: they live in the kgsm-speech leaf, one
         process per host serving every surface, because 1.6GB of models and the CUDA runtime behind
         them cannot be given back by anything short of a process ending. This is the client and the
         wire contract for its socket — a few kilobytes, no native dependency, and nothing to load. -->
    <PackageReference Include="TheKrystalShip.KGSM.Speech" Version="1.3.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
    <!-- The bot's own guild store. Already in the graph beneath TheKrystalShip.KGSM.Auth.Users at
         this same version, so naming it here costs nothing and stops the store depending on which
         package happens to pull it. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KGSM.Bot.Application\KGSM.Bot.Application.csproj" />
    <ProjectReference Include="..\KGSM.Bot.Core\KGSM.Bot.Core.csproj" />
    <!-- kgsm-lib consumed as the packed NuGet from the local feed (nuget.config →
         /home/heisen/local-nuget), same pattern as every other .NET consumer. -->
    <PackageReference Include="TheKrystalShip.KGSM.Lib" Version="5.0.0" />
    <PackageReference Include="TheKrystalShip.KGSM.Auth" Version="3.0.0" />
    <!-- This host's KGSM accounts, which are what say who may act here. Opened directly off the
         shared store file rather than asked for over HTTP: a file cannot be down, so the bot goes on
         authorizing people with every other leaf stopped. -->
    <PackageReference Include="TheKrystalShip.KGSM.Auth.Users" Version="1.2.0" />
    <!-- The assistant leaf's own relay contract: the headers that carry who is asking and what they
         may do. Published by the service that reads them, so this bot and the Control Panel API
         cannot come to spell an identity differently. -->
    <PackageReference Include="TheKrystalShip.Kgsm.Assistant.Relay" Version="1.1.0" />
  </ItemGroup>
</Project>
