<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>KGSM.Bot.Infrastructure</RootNamespace>

    <!-- This library declares bound settings sections, so it compiles the descriptor attributes and
         emits the documentation file their <panel> tags travel in. It generates nothing itself — the
         Discord host owns that step. -->
    <GenerateComponentDescriptor>false</GenerateComponentDescriptor>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TheKrystalShip.KGSM.ComponentConfig" Version="3.2.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The assistant client's transport seam is internal; let the tests supply one. -->
    <InternalsVisibleTo Include="KGSM.Bot.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.5" />
    <!-- BackgroundService, for the worker that drains the voice queue. Abstractions only: this
         project hosts nothing, it just needs the base class the entry point will host. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.5" />
    <PackageReference Include="Discord.Net" Version="3.20.1" />
    <!-- Hearing and speaking. The models are NOT here: they live in the kgsm-speech leaf, one
         process per host serving every surface, because 1.6GB of models and the CUDA runtime behind
         them cannot be given back by anything short of a process ending. This is the client and the
         wire contract for its socket — a few kilobytes, no native dependency, and nothing to load. -->
    <PackageReference Include="TheKrystalShip.Speech" Version="1.2.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
    <!-- The bot's own guild store. Already in the graph beneath TheKrystalShip.Auth.Cluster,
         so naming it here costs nothing and stops the store depending on which package happens to
         pull it. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KGSM.Bot.Application\KGSM.Bot.Application.csproj" />
    <ProjectReference Include="..\KGSM.Bot.Core\KGSM.Bot.Core.csproj" />
    <PackageReference Include="TheKrystalShip.KGSM.Lib" Version="9.0.0" />
    <PackageReference Include="TheKrystalShip.Auth" Version="5.0.0" />

    <!-- The cluster's authority, read off the replica the node on this machine keeps, and evaluated
         here: who a Discord account is, and what they may do at the server a command names. Opened
         directly off the file rather than asked for over HTTP, so the bot goes on authorizing people
         with every other leaf stopped. Also how this bot tells the auth anchor what it performs. -->
    <PackageReference Include="TheKrystalShip.Auth.Cluster" Version="2.0.0" />
    <!-- The assistant's per-turn contract: which leaf is calling, the conversation and room a turn
         belongs to, the auto-accept preference, and the liveness probe. Published by the service that
         reads them, so this bot cannot come to spell one differently. -->
    <PackageReference Include="TheKrystalShip.Kgsm.Assistant.Relay" Version="2.0.0" />

    <!-- Membership. This bot calls the assistant as a MEMBER of the cluster, with its own service
         token, naming the person whose message it is acting on. Holding the cluster secret is what
         makes that token believable; the package is inert without one, which is the state a bot on a
         machine standing alone is in. -->
    <PackageReference Include="TheKrystalShip.KGSM.Cluster" Version="1.0.0" />
    <!-- The member half of the cluster's names: stating where this bot is reached, and keeping a
         certificate and a served site for the capability name it holds. -->
    <PackageReference Include="TheKrystalShip.KGSM.Dns" Version="0.2.0" />
  </ItemGroup>
</Project>
